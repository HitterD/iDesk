<mxfile host="app.diagrams.net">
  <diagram id="login_flow" name="Alur Login iDesk">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Nodes -->
        <mxCell id="start" value="MULAI LOGIN&#10;(Buka Aplikasi)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="200" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="input" value="Masukkan Email &amp;amp; Password" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="200" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="cek_kredensial" value="Email &amp;amp; Password Benar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="240" width="200" height="80" as="geometry" />
        </mxCell>
        
        <!-- Rate Limit Nodes -->
        <mxCell id="cek_rate_limit" value="Batas Percobaan Login&#10;Sudah Habis?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="240" width="200" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="gagal_login" value="Gagal Login&#10;(Sistem Mencatat &amp;amp; Pesan Error)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="140" width="200" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="blokir_akun" value="Akses Diblokir Sementara&#10;(Terlalu Banyak Mencoba)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="240" width="200" height="80" as="geometry" />
        </mxCell>
        
        <!-- Continue Main Flow -->
        <mxCell id="buat_token" value="Sistem Membuat Access Token&#10;&amp;amp; Refresh Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="220" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="set_waktu" value="Atur Batas Waktu Akses&#10;(Admin: 3 Jam, Karyawan: 1 Jam)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="460" width="220" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="simpan_dashboard" value="Token Disimpan di Browser&#10;&amp;amp; Masuk ke Dashboard Sesuai Jabatan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="560" width="240" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="aktivitas" value="Pengguna Beraktivitas&#10;(Mengeklik Menu atau Halaman)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="660" width="240" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="cek_access" value="Access Token Masih Berlaku&#10;&amp;amp; Memiliki Izin Buka Halaman?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="760" width="240" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="lanjut_akses" value="Izinkan Akses&#10;(Halaman Ditampilkan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="920" width="240" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="cek_refresh" value="Refresh Token Masih Berlaku?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="760" width="240" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="perbarui_token" value="Perpanjang Otomatis&#10;(Tukar Refresh Token dengan&#10;Access Token Baru Tanpa Login Ulang)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="920" width="240" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="force_logout" value="Akses Ditolak&#10;(Pengguna Dikeluarkan Paksa&#10;&amp;amp; Harus Login Ulang)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="770" width="200" height="80" as="geometry" />
        </mxCell>
        
        <!-- Edges -->
        <mxCell id="e_start_input" edge="1" parent="1" source="start" target="input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_input_cek" edge="1" parent="1" source="input" target="cek_kredensial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_cek_rate" value="Tidak" edge="1" parent="1" source="cek_kredensial" target="cek_rate_limit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#FF0000;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_rate_belum" value="Belum" edge="1" parent="1" source="cek_rate_limit" target="gagal_login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#006600;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_gagal_input" value="Coba Lagi" edge="1" parent="1" source="gagal_login" target="input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_rate_habis" value="Ya (Melebihi Batas)" edge="1" parent="1" source="cek_rate_limit" target="blokir_akun" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#FF0000;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_cek_buat" value="Ya" edge="1" parent="1" source="cek_kredensial" target="buat_token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#006600;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_buat_set" edge="1" parent="1" source="buat_token" target="set_waktu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_set_dashboard" edge="1" parent="1" source="set_waktu" target="simpan_dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_dashboard_aktivitas" edge="1" parent="1" source="simpan_dashboard" target="aktivitas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_aktivitas_cek_access" edge="1" parent="1" source="aktivitas" target="cek_access" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_access_lanjut" value="Ya (Valid &amp;amp; Punya Izin)" edge="1" parent="1" source="cek_access" target="lanjut_akses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#006600;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_access_refresh" value="Tidak (Habis Waktu)" edge="1" parent="1" source="cek_access" target="cek_refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#FF0000;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_refresh_perbarui" value="Ya (Valid)" edge="1" parent="1" source="cek_refresh" target="perbarui_token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#006600;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_refresh_logout" value="Tidak (Habis Waktu)" edge="1" parent="1" source="cek_refresh" target="force_logout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#FF0000;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_perbarui_lanjut" edge="1" parent="1" source="perbarui_token" target="lanjut_akses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_lanjut_aktivitas" edge="1" parent="1" source="lanjut_akses" target="aktivitas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="950" />
              <mxPoint x="200" y="690" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
