<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SJANotifier</AssemblyName>
    <RootNamespace>SJANotificationApp</RootNamespace>
    <Version>1.0.1</Version>
    <Authors>PT Santos Jaya Abadi</Authors>
    <Company>PT Santos Jaya Abadi</Company>
    <Product>SJA Notification App</Product>
    <Description>Aplikasi Notifikasi Taskbar Tray untuk Portal iDesk dan Web Internal Santos</Description>
    <ApplicationIcon>assets\santos-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <Reference Include="AxWMPLib">
      <HintPath>libs\AxWMPLib.dll</HintPath>
    </Reference>
    <Reference Include="WMPLib">
      <HintPath>libs\WMPLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
