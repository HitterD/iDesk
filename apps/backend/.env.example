# ===========================================
# iDesk Backend Environment Configuration
# ===========================================

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5454
DB_USERNAME=postgres
DB_PASSWORD=generate-a-strong-database-password-here
DB_DATABASE=idesk_db
DB_LOGGING=false
# Pool size limits; falls back to 5 min / 20 max if unset
DB_POOL_MIN=2
DB_POOL_MAX=10
# Schema auto-sync; MUST be 'false' in production or server will fail to boot
DB_SYNCHRONIZE=false
# Slow query execution warning threshold in ms; falls back to 1000ms if unset
SLOW_QUERY_THRESHOLD_MS=1000

# JWT Authentication (REQUIRED - must be at least 32 characters)
# Generate a new secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_SECRET_KEY_FOR_PRODUCTION_USE
JWT_EXPIRES_IN=60m
ENCRYPTION_KEY=generate-64-char-hex-credential-key-here
EFORM_ENCRYPTION_KEY=generate-64-char-hex-eform-key-here

# Cookie & Session Security (CRITICAL FOR PRODUCTION)
# If unset or false: auth cookies travel over plaintext HTTP and Helmet HSTS header is disabled
COOKIE_SECURE=true
# Session storage mode: 'legacy' (hashed on user row), 'dual' (Redis+DB), 'redis' (Redis only; fails boot without REDIS_ENABLED=true)
AUTH_REFRESH_SESSION_MODE=legacy
# Confirmation flag required to run migration 1785000001000 to drop legacy refreshToken column; migration is skipped if unset
AUTH_LEGACY_REFRESH_DROP=confirmed

# ===========================================
# Zoom Booking & Calendar Integration
# ===========================================
# Server-to-Server OAuth App credentials from https://marketplace.zoom.us
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
# Secret token to verify Zoom webhook events (HMAC SHA256); if unset, webhook requests fail signature check
ZOOM_WEBHOOK_SECRET=your-zoom-webhook-secret
# Google Calendar OAuth client ID for Zoom sync; if unset, Google Calendar sync is disabled
GOOGLE_CALENDAR_CLIENT_ID=your-google-client-id
# Google Calendar ID; defaults to 'primary' if unset
GOOGLE_CALENDAR_ID=primary
# Microsoft Outlook OAuth client ID for Zoom sync; if unset, Outlook sync is disabled
OUTLOOK_CLIENT_ID=your-outlook-client-id

# ===========================================
# Telegram Bot Configuration
# ===========================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather

# Telegram Mode: 'polling' (development) or 'webhook' (production)
# Set to 'true' to use webhook mode
TELEGRAM_USE_WEBHOOK=false

# Webhook Configuration (only needed if TELEGRAM_USE_WEBHOOK=true)
TELEGRAM_WEBHOOK_DOMAIN=https://api.yourapp.com
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# Required when TELEGRAM_USE_WEBHOOK=true
TELEGRAM_WEBHOOK_SECRET=generate-a-random-webhook-secret-here

# ===========================================
# Redis Configuration (for Bull Queue & Caching)
# ===========================================
# Set to 'true' to enable Redis-based queues and cache (recommended for production)
REDIS_ENABLED=false

# Redis connection settings (only needed if REDIS_ENABLED=true)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Default cache TTL in seconds; falls back to 300s if unset
CACHE_TTL=300

# ===========================================
# File Upload Configuration
# ===========================================
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=/uploads

# ===========================================
# Email (SMTP) Configuration
# Initial values only — once the app boots, Settings > Email in the UI is the source of truth.
# The DB row seeded from these vars is never overwritten on restart.
# ===========================================
SMTP_HOST=mail.kapalapi.co.id
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email
SMTP_PASS=your-password
SMTP_FROM='iDesk Support <noreply@idesk.com>'
# Target email for SLA breach alerts and escalation notifications; falls back to admin@idesk.com if unset
SLA_ADMIN_EMAIL=admin@idesk.com

# ===========================================
# Application Settings
# ===========================================
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Number of trusted reverse proxies in front of the app for HTTP rate limiting.
# - If unset or 0 behind a reverse proxy, X-Forwarded-For is ignored and all requests
#   resolve to the proxy IP (all users share ONE throttle bucket, blocking legitimate users).
# - If set too high, clients can forge XFF headers and evade rate limiting entirely.
# Set N to the exact count of trusted proxies in front of the app (e.g. 1 for nginx, 2 for Cloudflare+nginx).
TRUSTED_PROXY_COUNT=

# ===========================================
# Hardware Request Module
# ===========================================
# WS_CORS_ORIGIN: comma-separated allowed origins for WebSocket gateway
# REQUIRED in production — server will reject all connections if not set
WS_CORS_ORIGIN=http://localhost:5173

# TRUST_PROXY: set to 'true' only when a reverse proxy that always overwrites
# X-Forwarded-For sits in front (the bundled nginx does). The WebSocket gateway
# then rate limits per real client IP instead of per proxy IP.
# Leave unset on a directly exposed deployment: the header is client-controlled
# there, and trusting it lets anyone bypass the connection limiter.
TRUST_PROXY=true

# Set to 'true' to run ict_budget data migration in dry-run mode (no DB changes)
HARDWARE_MIGRATION_DRY_RUN=false

# ===========================================
# Rate Limiting
# ===========================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
PAGE_ACCESS_CACHE_TTL=300       # Cache TTL in seconds
PAGE_ACCESS_MAX_DENIALS=10      # Before lockout
PAGE_ACCESS_LOCKOUT_MINUTES=15  # Lockout duration

# ===========================================
# Google API Spreadsheet
# ===========================================
# Path to your Google Cloud service account JSON file
GOOGLE_CREDENTIALS_PATH=c:/iDesk/idesk-481813-271700b60e92.json

# ===========================================
# HRIS API Gateway (NIK login)
# ===========================================
HRIS_GATEWAY_BASE_URL=http://10.10.6.51:27080/api/v1
HRIS_GATEWAY_API_KEY=your-hris-gateway-api-key

# Set to 'false' to skip HRIS password verification on NIK login and rely on the
# locally stored password only. Development-only escape hatch for an unreachable
# gateway: users without a local password cannot log in, and HRIS employment
# eligibility (e.g. resigned) is no longer enforced. Leave unset in production.
HRIS_LOGIN_VERIFY_ENABLED=true
# Timeout in milliseconds for HRIS API requests; falls back to 10000ms (10s) if unset
HRIS_GATEWAY_TIMEOUT_MS=10000

# ===========================================
# Web Push Notifications (VAPID)
# ===========================================
# Generate keys using: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@idesk.com

# ===========================================
# Synology / Automated Database Backup Ops
# ===========================================
# Encryption key for Synology automated backups; falls back to hardcoded default if unset
BACKUP_ENCRYPTION_KEY=generate-32-char-backup-key-here
# PostgreSQL Docker container name used in backup tasks; falls back to 'idesk-postgres' if unset
DB_DOCKER_CONTAINER=idesk-postgres
# Custom path to pg_dump executable; uses system PATH if unset
PG_DUMP_PATH=

# ===========================================
# Database Seed Credentials (Initial Setup Only)
# ===========================================
# Required for running initial database seed scripts (seed.ts / initial-seed.ts; min 12 chars)
SEED_ADMIN_PASSWORD=your-seed-admin-password-min-12-chars
SEED_DEFAULT_PASSWORD=your-seed-default-password-min-12-chars
