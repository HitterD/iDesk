<!DOCTYPE html>
<html lang="id" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<title>Permintaan Akses - iDesk</title>
<!--[if mso]><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml><![endif]-->
<style>
  body { margin: 0; padding: 0; background: #F1F0EC; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
  a { color: #2D4A8C; text-decoration: none; }
  @media only screen and (max-width: 600px) {
    .pad { padding: 20px !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#F1F0EC;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">Permintaan akses {{request.formType}} dari {{request.requesterName}} {{#if siteLabel}}[{{siteLabel}}]{{/if}} menunggu tindak lanjut.</div>
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">&#847; &zwnj; &nbsp; &#8199; &shy;</div>

<center style="width:100%;background:#F1F0EC;">
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#F1F0EC;">
<tr>
<td align="center" style="padding: 24px 12px;">
<!--[if mso]><table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="width:100%;max-width:600px;background:#FFFFFF;border-radius:16px;overflow:hidden;border:1px solid #E7E5E0;">
  
  <!-- Header Banner -->
  <tr>
    <td style="background:#0F172A;background:linear-gradient(135deg,#0F172A 0%,#1E3A5F 55%,#2D4A8C 100%);padding:28px 28px 26px 28px;">
      <span style="display:inline-block;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.18);color:#E0F2FE;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;font-weight:700;padding:5px 12px;border-radius:999px;">
        PERMINTAAN AKSES {{request.formType}} {{#if siteLabel}}[{{siteLabel}}]{{/if}}
      </span>
      <h1 style="margin:14px 0 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:22px;line-height:26px;color:#FFFFFF;font-weight:800;">
        Perlu Tindak Lanjut
      </h1>
      <p style="margin:8px 0 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;color:#C7D2FE;">
        Pemohon <strong style="color:#FFFFFF;">{{request.requesterName}}</strong> mengajukan akses {{request.formType}}.
      </p>
    </td>
  </tr>

  <!-- Body Content -->
  <tr>
    <td style="padding: 28px;" class="pad">
      <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:22px;color:#1F2937;">
        Halo <strong>{{recipientName}}</strong>,
      </p>
      <p style="margin:10px 0 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;color:#4B5563;">
        Terdapat pengajuan e-form yang memerlukan tindakan atau peninjauan Anda:
      </p>

      <!-- Summary Card -->
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top:18px;background:#F8F6F3;border:1px solid #E7E5E0;border-radius:12px;">
        <tr>
          <td style="padding:18px;">
            <div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:#6B7280;font-weight:700;margin-bottom:8px;">
              DETAIL PERMINTAAN
            </div>
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
              <tr>
                <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;color:#6B7280;width:35%;padding:4px 0;">
                  Pemohon:
                </td>
                <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;color:#0F172A;padding:4px 0;">
                  {{request.requesterName}}
                </td>
              </tr>
              <tr>
                <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;color:#6B7280;padding:4px 0;">
                  Jenis Akses:
                </td>
                <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;color:#0F172A;padding:4px 0;">
                  {{request.formType}} {{#if siteLabel}}<span style="display:inline-block;margin-left:4px;font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;background:#DBEAFE;color:#1E40AF;border:1px solid #BFDBFE;">{{siteLabel}}</span>{{/if}}
                </td>
              </tr>
              <tr>
                <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;color:#6B7280;padding:4px 0;">
                  Status:
                </td>
                <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;color:#1E40AF;padding:4px 0;">
                  {{request.status}}
                </td>
              </tr>
              <tr>
                <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;color:#6B7280;padding:4px 0;">
                  ID:
                </td>
                <td style="font-family:monospace;font-size:12px;color:#374151;padding:4px 0;">
                  {{request.id}}
                </td>
              </tr>
            </table>

            {{#if request.rejectionReason}}
            <div style="margin-top:12px;background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;padding:10px 12px;">
              <div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;color:#991B1B;text-transform:uppercase;letter-spacing:0.06em;">Alasan Penolakan</div>
              <div style="margin-top:4px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;color:#7F1D1D;line-height:19px;">{{request.rejectionReason}}</div>
            </div>
            {{/if}}
          </td>
        </tr>
      </table>

      <!-- CTA Button -->
      {{#if link}}
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-top:20px;">
        <tr>
          <td>
            <!--[if mso]>
            <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="{{link}}" style="height:44px;v-text-anchor:middle;width:210px;" arcsize="22%" fillcolor="#2D4A8C" stroke="f">
            <center style="color:#FFFFFF;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;">Buka Detail Permintaan &rarr;</center>
            </v:roundrect>
            <![endif]-->
            <!--[if !mso]><!-->
            <a href="{{link}}" style="display:inline-block;background:#2D4A8C;color:#FFFFFF;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;text-decoration:none;padding:12px 22px;border-radius:10px;">
              Buka Detail Permintaan &rarr;
            </a>
            <!--<![endif]-->
          </td>
        </tr>
      </table>
      <p style="margin:10px 0 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#6B7280;word-break:break-all;">
        Jika tombol tidak berfungsi, salin tautan ini: <a href="{{link}}" style="color:#2D4A8C;word-break:break-all;">{{link}}</a>
      </p>
      {{/if}}

      <p style="margin:18px 0 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#9CA3AF;">
        Anda menerima email ini karena peran Anda terkait otorisasi atau pemrosesan permintaan e-form.
      </p>
    </td>
  </tr>

  <!-- Footer -->
  <tr>
    <td style="background:#F8F6F3;border-top:1px solid #E7E5E0;padding:14px 28px;text-align:center;">
      <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;color:#6B7280;">
        &copy; {{year}} iDesk &middot; Helpdesk System
      </p>
      {{#if link}}
      <p style="margin:6px 0 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;">
        <a href="{{link}}" style="color:#4B5563;text-decoration:underline;">Buka di iDesk</a>
      </p>
      {{/if}}
    </td>
  </tr>

</table>
<!--[if mso]></td></tr></table><![endif]-->
</td>
</tr>
</table>
</center>
</body>
</html>
