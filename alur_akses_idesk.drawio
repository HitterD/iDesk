        <mxCell id="e_5" value="Ya" edge="1" parent="1" source="cek_mgr1" target="mgr1_ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#006600;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e_6" value="Tidak" edge="1" parent="1" source="cek_mgr1" target="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#FF0000;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
