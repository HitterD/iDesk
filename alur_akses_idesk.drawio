        <mxCell id="e_7" edge="1" parent="1" source="mgr1_ok" target="mgr2_review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_8" edge="1" parent="1" source="mgr2_review" target="cek_mgr2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_9" value="Ya" edge="1" parent="1" source="cek_mgr2" target="mgr2_ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#006600;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_10" value="Tidak" edge="1" parent="1" source="cek_mgr2" target="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#FF0000;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;">
