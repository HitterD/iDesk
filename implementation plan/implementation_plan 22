### 2. Backend — Fix Procurement Workflow

#### [MODIFY] [procurement-decision.service.ts](file:///d:/iDesk-main/apps/backend/src/modules/hardware-request/services/procurement-decision.service.ts)

**Problem:** `decideItems()` tidak transisi status dari APPROVED → PROCUREMENT. Akibatnya `completeProcurement()` gagal karena expect status PROCUREMENT.

**Fix:** Tambah auto-transition di `decideItems()` — saat request masih APPROVED, transisi ke PROCUREMENT.

```diff
 async decideItems(
   requestId: string,
   dto: ProcurementDecisionDto,
   actorId: string,
 ): Promise<HardwareRequestItem[]> {
+  // Auto-transition APPROVED → PROCUREMENT when first procurement decision is made
+  const req = await this.reqRepo.findOne({ where: { id: requestId } });
+  if (!req) throw new NotFoundException('request not found');
+  if (req.status === RequestStatus.APPROVED) {
+    if (!canTransition(RequestStatus.APPROVED, RequestStatus.PROCUREMENT)) {
+      throw new BadRequestException('cannot start procurement from current status');
+    }
+    req.status = RequestStatus.PROCUREMENT;
+    req.procuredById = actorId;
+    await this.reqRepo.save(req);
+  } else if (req.status !== RequestStatus.PROCUREMENT) {
+    throw new BadRequestException(`cannot decide items in status ${req.status}`);
+  }
+
   const ids = dto.decisions.map((d) => d.itemId);
   // ... rest unchanged
```

